# ================================================================
# Freelance AI Financial Engine - Environment Configuration
# ================================================================

# --- Telegram Bot API ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Restrict bot usage to specific Telegram User IDs (comma-separated)
# If left empty, any user can interact with their own isolated data
ALLOWED_TELEGRAM_USER_IDS=

# --- OpenAI API (Optional) ---
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini AI (100% Free Tier from Google AI Studio - https://aistudio.google.com/) ---
# Used for Free Receipt Vision OCR, Audio Voice Note transcription, and NLP
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database Storage Backend ---
# Supported values: "sqlite" (default local zero-setup) or "gsheets" (Google Sheets)
DB_BACKEND=sqlite
SQLITE_DB_PATH=data/freelance_finance.db

# --- Google Sheets API Settings (Optional if DB_BACKEND=gsheets) ---
# Path to the service account JSON key file, or raw JSON string
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SPREADSHEET_KEY=Freelance AI Financial Engine

# --- Freelance Financial Engine Defaults ---
DEFAULT_CURRENCY=IDR
# Default Tax / Operational reserve percentage deducted from every income (e.g. 10.0%)
DEFAULT_TAX_PERCENTAGE=10.0

# Base Salary / Minimum monthly living cost target (e.g. Rp 10.000.000)
DEFAULT_TARGET_SALARY=10000000

# Monthly Category Spending Budgets
DEFAULT_NEEDS_BUDGET=5000000
DEFAULT_WANTS_BUDGET=2500000
DEFAULT_OPERATIONAL_BUDGET=1500000

# Emergency Fund Target Goal (e.g. 3-6 months living costs = Rp 30.000.000)
DEFAULT_EMERGENCY_TARGET=30000000

# --- Automated Reporting Schedule ---
# 24-hour format: hour and minute to trigger scheduled reports
REPORT_TIME_HOUR=20
REPORT_TIME_MINUTE=0
